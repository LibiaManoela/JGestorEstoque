<?xml version="1.0" encoding="UTF-8"?>

<!-- Interface da Tela 1 (Catálogo completo de insumos). -->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.estoque.controller.CatalogoController"
      styleClass="painel-tela" spacing="18">

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Catálogo de Itens em Estoque" styleClass="titulo-pagina"/>
            <Label text="Consulte, filtre, edite ou remova materiais cadastrados no sistema." styleClass="subtitulo-pagina"/>
        </VBox>

        <HBox spacing="10">
            <Button fx:id="botaoEditar" text="✏️ Editar Selecionado" onAction="#editarSelecionado"
                    styleClass="botao-secundario" disable="true"/>
            <Button fx:id="botaoExcluir" text="🗑️ Excluir" onAction="#excluirSelecionado"
                    styleClass="botao-perigo" disable="true"/>
        </HBox>
    </HBox>

    <HBox styleClass="cartao" spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="campoBusca" promptText="🔍 Buscar por nome ou código SKU..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="filtroCategoria" prefWidth="230"/>
    </HBox>

    <TableView fx:id="tabelaEstoque" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colSku" text="SKU" prefWidth="120"/>
            <TableColumn fx:id="colNome" text="Nome do Material" prefWidth="280"/>
            <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="150"/>
            <TableColumn fx:id="colQuantidade" text="Qtd. Atual" prefWidth="100"/>
            <TableColumn fx:id="colMinimo" text="Est. Mínimo" prefWidth="100"/>
            <TableColumn fx:id="colPreco" text="Preço Unit. (R$)" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>